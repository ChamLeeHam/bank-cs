      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tickets\nSET notification_status = 'failed',\n    notification_attempts = notification_attempts + 1\nWHERE ticket_id = $1\n  AND notification_status = 'processing';",
        "options": {
          "queryReplacement": "={{ [ $('Edit Fields').item.json.ticket_id ] }}"
