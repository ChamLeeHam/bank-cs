    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ticket_id, notification_status, assigned_agent, intent, priority,\n       notification_claimed_at, notification_attempts\nFROM tickets\nWHERE notification_status = 'processing'\n  AND notification_alerted_at IS NULL\n  AND (\n      notification_claimed_at IS NULL\n      OR notification_claimed_at < NOW() - INTERVAL 10 MINUTE\n  )\nORDER BY notification_claimed_at, ticket_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        -128,
        -48
      ],
      "id": "cabc122e-4925-4612-8da5-9d2ddfbf8f06",
      "name": "Execute a SQL query"
    },
    {
