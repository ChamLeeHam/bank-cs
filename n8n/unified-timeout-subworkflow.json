    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tickets\nSET notification_alerted_at = NOW()\nWHERE ticket_id = $1\n  AND notification_status = 'processing'\n  AND notification_alerted_at IS NULL\n  AND notification_claimed_at <=> $2;",
        "options": {
          "queryReplacement": "={{ [\n  $('Execute a SQL query').item.json.ticket_id,\n  $('Execute a SQL query').item.json.notification_claimed_at\n] }}"
