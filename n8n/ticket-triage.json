      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ticket_id, intent, priority, status,\n       notification_status, created_at\nFROM tickets\nWHERE notification_status = 'pending'\nORDER BY created_at ASC, ticket_id ASC\nLIMIT 20;",
        "options": {}
      },
      "id": "cb87a3a1-7090-4b18-bf17-e3c0c65c9517",
      "name": "读取待处理工单",
