      "typeVersion": 2.4,
      "position": [
        -352,
        32
      ],
      "alwaysOutputData": false,
      "notesInFlow": true,
      "notes": "使用演示 MySQL 凭据。只读取工单元数据，不读取客户消息。"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({ json }, index) => ({\n  json: {\n    ticket_id: json.ticket_id,\n    intent: json.intent,\n    priority: json.priority,\n    status: json.status,\n    notification_status: json.notification_status,\n    created_at: json.created_at,\n    message: `新工单 #${json.ticket_id}，类型：${json.intent}，优先级：${json.priority}。请登录工单工作台查看。`,\n  },\n  pairedItem: { item: index },\n}));"
      },
      "id": "9f46d0ae-4e69-4c14-9df2-f2dfb46b2787",
