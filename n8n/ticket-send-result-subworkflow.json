        "assignments": {
          "assignments": [
            {
              "id": "4f5ec449-274e-45fb-a0b9-0422f5752035",
              "name": "ticket_id",
              "value": "={{ $json.ticket_id }}",
              "type": "number"
            },
            {
              "id": "11115dd2-e46a-4151-aac6-3e48943530db",
              "name": "result",
              "value": "simulated",
              "type": "string"
            }
          ]
