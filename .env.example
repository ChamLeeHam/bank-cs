# Copy to .env and fill in
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lioncity_bank
MYSQL_CHARSET=utf8mb4

# Gate thresholds (optional; defaults 0.5 / 0.3, measured on the test set)
INTENT_THRESHOLD=0.5
CLARIFY_THRESHOLD=0.3

# DeepSeek (OpenAI-compatible): Day 2 training data generation
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
