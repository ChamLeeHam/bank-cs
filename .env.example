# Copy to .env and fill in
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lioncity_bank
MYSQL_CHARSET=utf8mb4

# Gate thresholds (optional; defaults 0.5 / 0.3, measured on the test set)
INTENT_THRESHOLD=0.5
CLARIFY_THRESHOLD=0.3

# DeepSeek (OpenAI-compatible): Day 2 training data generation
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-flash

# RAG answer generator: deepseek (default) or local
RAG_GENERATOR=deepseek
# true: knowledge-base questions go to the Bank Agent (DeepSeek picks the tools); false: the fixed RAG workflow
BANK_USE_AGENT=false
BANK_KB_COLLECTION=lioncity_faq
# Real bank PDFs parsed by MinerU go into a separate collection (not mixed with the Lion City Bank FAQ)
BANK_PDF_COLLECTION=bank_pdf_docs
MINERU_OUTPUT_DIR=data/kb/mineru_output

# RAG pipeline (same structure as course 03-rag); BANK_ prefix avoids clashing with the course's RERANKER_* settings
BANK_RAG_REWRITE=true
BANK_RAG_HYDE=true
BANK_RAG_CANDIDATES=10
BANK_HYDE_WEIGHT=0.7
BANK_RERANK_MIN_TOPK=1
BANK_RERANK_MAX_TOPK=3
BANK_RERANK_GAP_ABS=0.3
BANK_RERANK_RATIO=0.5
BANK_RERANK_MIN_SCORE=0.01
